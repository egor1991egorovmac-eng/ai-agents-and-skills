12:["$","p","p-3",{"children":["Manifest: обязательны ",["$","code","code-0",{"children":"e2eQuery"}],", ",["$","code","code-1",{"children":"e2eVariables"}],", ",["$","code","code-2",{"children":"assertions"}],"; опционально ",["$","code","code-3",{"children":"idempotencyKey"}],". В workspace ",["$","code","code-4",{"children":".env"}]," обязательны ",["$","code","code-5",{"children":"BFF_PIPELINE_BFF_ROOT"}]," и ",["$","code","code-6",{"children":"BFF_PIPELINE_BFF_TARGET"}],"."]}]
