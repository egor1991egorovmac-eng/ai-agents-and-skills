36:["$","ol","ol-0",{"children":["\n",["$","li","li-0",{"children":[["$","strong","strong-0",{"children":"Генерация кода"}]," — AI (stage skills). ",["$","strong","strong-1",{"children":"Проверки"}]," — только runner."]}],"\n",["$","li","li-1",{"children":["Не интерпретировать stdout команд — только ",["$","code","code-0",{"children":"status"}],"/",["$","code","code-1",{"children":"compact"}],"/",["$","code","code-2",{"children":"checks"}]," из runner."]}],"\n",["$","li","li-2",{"children":[["$","strong","strong-0",{"children":"FAIL"}]," — исправить код, повторить тот же ",["$","code","code-0",{"children":"--stage"}],". Override нельзя."]}],"\n",["$","li","li-3",{"children":[["$","strong","strong-0",{"children":"BLOCKED"}]," — сообщить пользователю; продолжение только после явного override или ",["$","code","code-0",{"children":"--confirm apply"}],"."]}],"\n",["$","li","li-4",{"children":["При ",["$","strong","strong-0",{"children":"PASS"}]," не загружать полный log в контекст. При ",["$","strong","strong-1",{"children":"FAIL"}],"/",["$","strong","strong-2",{"children":"BLOCKED"}]," из ",["$","code","code-0",{"children":"logPath"}]," читать только хвост (~50 строк), не весь файл."]}],"\n",["$","li","li-5",{"children":["После ",["$","strong","strong-0",{"children":"PASS"}]," этапа N — короткий статус («Этап N PASS») и ",["$","strong","strong-1",{"children":"сразу"}]," генерировать/вызывать этап N+1 без подтверждения. Спрашивать пользователя только на ",["$","strong","strong-2",{"children":"BLOCKED"}],", на развилке продукта (поля схемы, имя операции) до генерации, и в конце пайплайна (после этапа 6 PASS). ",["$","strong","strong-3",{"children":"FAIL"}]," — чинить код, повторить тот же этап."]}],"\n",["$","li","li-6",{"children":["Уже зелёный этап в V1 без fingerprint V2 — ",["$","strong","strong-0",{"children":"не"}]," считать пройденным для V2."]}],"\n",["$","li","li-7",{"children":[["$","strong","strong-0",{"children":"Не читать реализацию runner."}]," Запрещено открывать ",["$","code","code-0",{"children":"scripts/"}],", ",["$","code","code-1",{"children":"scripts/lib/**"}],", ",["$","code","code-2",{"children":"*.mjs"}]," гейты, AST-чекеры, фикстуры тестов и внутренности SPEC, чтобы понять, как устроена проверка. AI только ",["$","strong","strong-1",{"children":"вызывает"}]," CLI (",["$","code","code-3",{"children":"preflight"}]," / ",["$","code","code-4",{"children":"verify --stage"}]," / ",["$","code","code-5",{"children":"run"}],") и читает компактный JSON: ",["$","code","code-6",{"children":"status"}],", ",["$","code","code-7",{"children":"compact"}],", при FAIL/BLOCKED — ",["$","code","code-8",{"children":"checks"}]," и хвост ",["$","code","code-9",{"children":"logPath"}]," (~50 строк). При FAIL чинить ",["$","strong","strong-2",{"children":"продуктовый код"}]," (схема / datasource / resolver / apollo) по detail упавших ",["$","code","code-10",{"children":"checks"}]," — не исходники runner. Разрешено читать: этот SKILL.md, продуктовый код bff/client, типы ",["$","code","code-11",{"children":"@realt-by/api-schema"}],", соседние резолверы/.gql как шаблоны генерации."]}],"\n"]}]
